PORT=3000
# Optional OpenAI-compatible provider, e.g. your Liara AI gateway.
# Never put these in dist/ or client-side JavaScript.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional adapter endpoint YOU control, with the contract documented in README.
CALL_ADAPTER_URL=
CALL_ADAPTER_TOKEN=
# Required to protect real call requests; use a long random secret.
CALL_ADMIN_TOKEN=
# Admin secret: generate at least 24 random characters. Never expose it to the browser bundle.
ADMIN_PASSWORD=
STATE_DIR=./runtime
# Costs: one instance, Tehran calendar day, conservative UTF-8 token reservations.
AI_DAILY_REQUESTS=10
AI_DAILY_TOKENS=30000
# Optional existing Elasticsearch. Leave empty for the in-process inverted index.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=torob-products
